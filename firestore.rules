rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isVerifiedUser() && existing().ownerId == request.auth.uid;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidOptionalNumber(data, key) {
      return !(key in data) || (data[key] is number);
    }

    function isValidOptionalBool(data, key) {
      return !(key in data) || (data[key] is bool);
    }

    function isValidTags(data) {
      return !('tags' in data) || (
        data.tags is list &&
        data.tags.size() <= 10 &&
        (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 32))
      );
    }

    function isValidSchedulesArray(data) {
      return data.schedules is list &&
        data.schedules.size() <= 120 &&
        (data.schedules.size() == 0 || data.schedules[0] is map);
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'preferredLang',
          'defaultCurrency', 'exchangeRateKhr', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'lenderPhone', 'lenderLogoDataUrl',
          'preferredLang', 'defaultCurrency', 'exchangeRateKhr', 'capitalCashUsd',
          'capitalCashKhr', 'useKhmerNumerals', 'pinHash',
          'biometricEnabled', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == request.auth.uid &&
        isValidId(data.uid) &&
        isValidString(data.email, 3, 200) &&
        isValidString(data.displayName, 1, 120) &&
        isValidOptionalString(data, 'lenderPhone', 40) &&
        isValidOptionalString(data, 'lenderLogoDataUrl', 200000) &&
        data.preferredLang in ['en', 'km'] &&
        data.defaultCurrency in ['USD', 'KHR'] &&
        data.exchangeRateKhr is number && data.exchangeRateKhr > 0 && data.exchangeRateKhr <= 100000 &&
        isValidOptionalNumber(data, 'capitalCashUsd') &&
        isValidOptionalNumber(data, 'capitalCashKhr') &&
        isValidOptionalBool(data, 'useKhmerNumerals') &&
        isValidOptionalString(data, 'pinHash', 128) &&
        isValidOptionalBool(data, 'biometricEnabled') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBorrower(data) {
      return data.keys().hasAll(['ownerId', 'name', 'phone', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'ownerId', 'name', 'phone', 'address', 'nationalIdNumber',
          'idPhotoDataUrl', 'borrowerPhotoDataUrl', 'guarantorName',
          'guarantorPhone', 'guarantorPhotoDataUrl', 'notes',
          'tags', 'riskScore', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        isValidString(data.name, 1, 120) &&
        isValidString(data.phone, 3, 40) &&
        isValidOptionalString(data, 'address', 300) &&
        isValidOptionalString(data, 'nationalIdNumber', 60) &&
        isValidOptionalString(data, 'idPhotoDataUrl', 250000) &&
        isValidOptionalString(data, 'borrowerPhotoDataUrl', 200000) &&
        isValidOptionalString(data, 'guarantorName', 120) &&
        isValidOptionalString(data, 'guarantorPhone', 40) &&
        isValidOptionalString(data, 'guarantorPhotoDataUrl', 200000) &&
        isValidOptionalString(data, 'notes', 1000) &&
        isValidTags(data) &&
        isValidOptionalNumber(data, 'riskScore') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLoan(data) {
      return data.keys().hasAll([
          'ownerId', 'borrowerId', 'borrowerName', 'currency',
          'principal', 'interestRate', 'interestType', 'termCount',
          'frequency', 'startDate', 'status', 'totalPayable',
          'outstandingBalance', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'borrowerId', 'borrowerName', 'currency',
          'principal', 'interestRate', 'interestType', 'termCount',
          'frequency', 'customIntervalDays', 'startDate', 'adminFee',
          'lateFeeType', 'lateFeeValue', 'gracePeriodDays',
          'collateralText', 'collateralPhotoUrl', 'signatureDataUrl',
          'status', 'totalPayable', 'totalInterest', 'paidPrincipal',
          'paidInterest', 'paidPenalty', 'outstandingBalance',
          'parentLoanId', 'portalShareId', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        isValidId(data.borrowerId) &&
        isValidString(data.borrowerName, 1, 120) &&
        data.currency in ['USD', 'KHR'] &&
        data.principal is number && data.principal > 0 &&
        data.interestRate is number && data.interestRate >= 0 &&
        data.interestType in ['flat', 'reducing', 'interest_only'] &&
        data.termCount is int && data.termCount >= 1 && data.termCount <= 360 &&
        data.frequency in ['daily', 'weekly', 'monthly', 'custom'] &&
        (!('customIntervalDays' in data) || (data.customIntervalDays is int && data.customIntervalDays >= 1 && data.customIntervalDays <= 365)) &&
        isValidString(data.startDate, 8, 30) &&
        isValidOptionalNumber(data, 'adminFee') &&
        (!('lateFeeType' in data) || data.lateFeeType in ['fixed', 'percent']) &&
        isValidOptionalNumber(data, 'lateFeeValue') &&
        (!('gracePeriodDays' in data) || (data.gracePeriodDays is int && data.gracePeriodDays >= 0 && data.gracePeriodDays <= 90)) &&
        isValidOptionalString(data, 'collateralText', 500) &&
        isValidOptionalString(data, 'collateralPhotoUrl', 250000) &&
        isValidOptionalString(data, 'signatureDataUrl', 120000) &&
        data.status in ['active', 'settled', 'written_off', 'renewed'] &&
        data.totalPayable is number && data.totalPayable >= 0 &&
        isValidOptionalNumber(data, 'totalInterest') &&
        isValidOptionalNumber(data, 'paidPrincipal') &&
        isValidOptionalNumber(data, 'paidInterest') &&
        isValidOptionalNumber(data, 'paidPenalty') &&
        data.outstandingBalance is number && data.outstandingBalance >= 0 &&
        isValidOptionalString(data, 'parentLoanId', 128) &&
        isValidOptionalString(data, 'portalShareId', 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLoanSchedule(data) {
      return data.keys().hasAll([
          'ownerId', 'loanId', 'borrowerId', 'installmentNumber',
          'dueDate', 'principalDue', 'interestDue', 'totalDue',
          'principalPaid', 'interestPaid', 'penaltyPaid', 'status', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'loanId', 'borrowerId', 'installmentNumber',
          'dueDate', 'principalDue', 'interestDue', 'totalDue',
          'principalPaid', 'interestPaid', 'penaltyPaid', 'status',
          'paidAt', 'updatedAt'
        ]) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        isValidId(data.loanId) &&
        isValidId(data.borrowerId) &&
        data.installmentNumber is int && data.installmentNumber >= 1 && data.installmentNumber <= 360 &&
        isValidString(data.dueDate, 8, 30) &&
        data.principalDue is number && data.principalDue >= 0 &&
        data.interestDue is number && data.interestDue >= 0 &&
        data.totalDue is number && data.totalDue >= 0 &&
        data.principalPaid is number && data.principalPaid >= 0 &&
        data.interestPaid is number && data.interestPaid >= 0 &&
        data.penaltyPaid is number && data.penaltyPaid >= 0 &&
        data.status in ['pending', 'partial', 'paid', 'overdue'] &&
        isValidOptionalString(data, 'paidAt', 40) &&
        data.updatedAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll([
          'ownerId', 'loanId', 'borrowerId', 'borrowerName', 'currency',
          'amount', 'principalPortion', 'interestPortion', 'penaltyPortion',
          'method', 'paymentDate', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'loanId', 'borrowerId', 'borrowerName', 'currency',
          'amount', 'principalPortion', 'interestPortion', 'penaltyPortion',
          'method', 'paymentDate', 'referenceNo', 'notes',
          'collectedBy', 'gpsLat', 'gpsLng', 'createdAt'
        ]) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        isValidId(data.loanId) &&
        isValidId(data.borrowerId) &&
        isValidString(data.borrowerName, 1, 120) &&
        data.currency in ['USD', 'KHR'] &&
        data.amount is number && data.amount > 0 &&
        data.principalPortion is number && data.principalPortion >= 0 &&
        data.interestPortion is number && data.interestPortion >= 0 &&
        data.penaltyPortion is number && data.penaltyPortion >= 0 &&
        data.method in ['cash', 'bank_transfer', 'khqr_aba'] &&
        isValidString(data.paymentDate, 8, 30) &&
        isValidOptionalString(data, 'referenceNo', 80) &&
        isValidOptionalString(data, 'notes', 400) &&
        isValidOptionalString(data, 'collectedBy', 120) &&
        isValidOptionalNumber(data, 'gpsLat') &&
        isValidOptionalNumber(data, 'gpsLng') &&
        data.createdAt is timestamp;
    }

    function isValidStaffMember(data) {
      return data.keys().hasAll(['ownerId', 'name', 'role', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'name', 'phone', 'role', 'active', 'createdAt', 'updatedAt']) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        isValidString(data.name, 1, 120) &&
        isValidOptionalString(data, 'phone', 40) &&
        data.role in ['owner', 'collector'] &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['ownerId', 'actorUid', 'actorName', 'action', 'entityType', 'entityId', 'summary', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'actorUid', 'actorName', 'action', 'entityType', 'entityId', 'summary', 'createdAt']) &&
        data.ownerId == request.auth.uid &&
        data.actorUid == request.auth.uid &&
        isValidId(data.ownerId) &&
        isValidString(data.actorName, 1, 120) &&
        isValidString(data.action, 1, 60) &&
        data.entityType in ['borrower', 'loan', 'payment', 'staff', 'settings'] &&
        isValidString(data.entityId, 1, 128) &&
        isValidString(data.summary, 1, 300) &&
        data.createdAt is timestamp;
    }

    function isValidPortalShare(data) {
      return data.keys().hasAll([
          'ownerId', 'loanId', 'borrowerFirstName', 'lenderName',
          'currency', 'principal', 'totalPayable', 'outstandingBalance',
          'status', 'schedules', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'loanId', 'borrowerFirstName', 'lenderName',
          'lenderPhone', 'lenderLogoDataUrl',
          'currency', 'principal', 'interestType', 'interestRate',
          'totalPayable', 'outstandingBalance',
          'status', 'schedules', 'updatedAt'
        ]) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        isValidId(data.loanId) &&
        isValidString(data.borrowerFirstName, 1, 80) &&
        isValidString(data.lenderName, 1, 120) &&
        isValidOptionalString(data, 'lenderPhone', 40) &&
        isValidOptionalString(data, 'lenderLogoDataUrl', 200000) &&
        data.currency in ['USD', 'KHR'] &&
        data.principal is number && data.principal > 0 &&
        (!('interestType' in data) || data.interestType in ['flat', 'reducing', 'interest_only']) &&
        isValidOptionalNumber(data, 'interestRate') &&
        data.totalPayable is number && data.totalPayable >= 0 &&
        data.outstandingBalance is number && data.outstandingBalance >= 0 &&
        data.status in ['active', 'settled', 'written_off', 'renewed'] &&
        isValidSchedulesArray(data) &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'lenderPhone', 'lenderLogoDataUrl',
          'preferredLang', 'defaultCurrency',
          'exchangeRateKhr', 'capitalCashUsd', 'capitalCashKhr',
          'useKhmerNumerals', 'pinHash', 'biometricEnabled', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /borrowers/{borrowerId} {
      allow get: if isValidId(borrowerId) && isDocOwner();
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(borrowerId) &&
        isValidBorrower(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(borrowerId) &&
        isValidBorrower(incoming()) &&
        isDocOwner() &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'phone', 'address', 'nationalIdNumber',
          'idPhotoDataUrl', 'borrowerPhotoDataUrl', 'guarantorName',
          'guarantorPhone', 'guarantorPhotoDataUrl', 'notes',
          'tags', 'riskScore', 'updatedAt'
        ]);
      allow delete: if isValidId(borrowerId) && isDocOwner();
    }

    match /loans/{loanId} {
      allow get: if isValidId(loanId) && isDocOwner();
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(loanId) &&
        isValidLoan(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (exists(/databases/$(database)/documents/borrowers/$(incoming().borrowerId)) &&
           get(/databases/$(database)/documents/borrowers/$(incoming().borrowerId)).data.ownerId == request.auth.uid) ||
          (existsAfter(/databases/$(database)/documents/borrowers/$(incoming().borrowerId)) &&
           getAfter(/databases/$(database)/documents/borrowers/$(incoming().borrowerId)).data.ownerId == request.auth.uid)
        );
      allow update: if isVerifiedUser() && isValidId(loanId) &&
        isValidLoan(incoming()) &&
        isDocOwner() &&
        incoming().ownerId == existing().ownerId &&
        incoming().borrowerId == existing().borrowerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().status == 'active' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'paidPrincipal', 'paidInterest', 'paidPenalty',
              'outstandingBalance', 'status', 'updatedAt'
            ])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'collateralText', 'collateralPhotoUrl', 'signatureDataUrl',
              'portalShareId', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(loanId) && isDocOwner();

      match /schedules/{installmentId} {
        allow get: if isValidId(loanId) && isValidId(installmentId) && isDocOwner() &&
          exists(/databases/$(database)/documents/loans/$(loanId)) &&
          get(/databases/$(database)/documents/loans/$(loanId)).data.ownerId == request.auth.uid;
        allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(loanId) && isValidId(installmentId) &&
          isValidLoanSchedule(incoming()) &&
          incoming().loanId == loanId &&
          incoming().updatedAt == request.time &&
          (
            (exists(/databases/$(database)/documents/loans/$(loanId)) &&
             get(/databases/$(database)/documents/loans/$(loanId)).data.ownerId == request.auth.uid) ||
            (existsAfter(/databases/$(database)/documents/loans/$(loanId)) &&
             getAfter(/databases/$(database)/documents/loans/$(loanId)).data.ownerId == request.auth.uid)
          );
        allow update: if isVerifiedUser() && isValidId(loanId) && isValidId(installmentId) &&
          isValidLoanSchedule(incoming()) &&
          isDocOwner() &&
          incoming().ownerId == existing().ownerId &&
          incoming().loanId == existing().loanId &&
          incoming().borrowerId == existing().borrowerId &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'principalPaid', 'interestPaid', 'penaltyPaid', 'status', 'paidAt', 'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/loans/$(loanId)) &&
          get(/databases/$(database)/documents/loans/$(loanId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(loanId) && isValidId(installmentId) && isDocOwner() &&
          exists(/databases/$(database)/documents/loans/$(loanId)) &&
          get(/databases/$(database)/documents/loans/$(loanId)).data.ownerId == request.auth.uid;
      }
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isDocOwner();
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(paymentId) &&
        isValidPayment(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/loans/$(incoming().loanId)) &&
        get(/databases/$(database)/documents/loans/$(incoming().loanId)).data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if isValidId(paymentId) && isDocOwner();
    }

    match /staff/{staffId} {
      allow get: if isValidId(staffId) && isDocOwner();
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(staffId) &&
        isValidStaffMember(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(staffId) &&
        isValidStaffMember(incoming()) &&
        isDocOwner() &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'phone', 'role', 'active', 'updatedAt'
        ]);
      allow delete: if isValidId(staffId) && isDocOwner();
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isDocOwner();
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /portalShares/{shareId} {
      allow get: if isValidId(shareId);
      allow list: if false;
      allow create: if isVerifiedUser() && isValidId(shareId) &&
        isValidPortalShare(incoming()) &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/loans/$(incoming().loanId)) &&
        get(/databases/$(database)/documents/loans/$(incoming().loanId)).data.ownerId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(shareId) &&
        isValidPortalShare(incoming()) &&
        isDocOwner() &&
        incoming().ownerId == existing().ownerId &&
        incoming().loanId == existing().loanId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'borrowerFirstName', 'lenderName', 'lenderPhone', 'lenderLogoDataUrl',
          'interestType', 'interestRate',
          'outstandingBalance', 'status', 'schedules', 'updatedAt'
        ]);
      allow delete: if isValidId(shareId) && isDocOwner();
    }
  }
}
